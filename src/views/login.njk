{% extends "base.njk" %}

{% block title %}Sign in | Kainos careers{% endblock %}

{% block bodyClass %}page-login{% endblock %}

{% block hero %}
	<h1>Sign in</h1>
	<p class="hero__subtitle">Sign in to manage job role information.</p>
{% endblock %}

{% block content %}
	<div class="page-content">
		<section class="card login-card" aria-labelledby="sign-in-heading">
			<h2 id="sign-in-heading">Sign in</h2>
			<p class="form-intro">Use your Kainos email address and password.</p>

			{% if error %}
				<p class="form-error" role="alert">{{ error }}</p>
			{% endif %}

			<form method="post" action="/login" novalidate>
				<div class="form-group">
					<label for="email">Email address</label>
					<span class="form-hint" id="email-hint">For example, name@kainos.com</span>
					<input type="email" id="email" name="email" autocomplete="username" aria-describedby="email-hint" required />
				</div>

				<div class="form-group">
					<label for="password">Password</label>
					<input type="password" id="password" name="password" autocomplete="current-password" required />
				</div>

				<button type="submit" class="button button--submit">Sign in</button>
				<p class="form-link"><a href="/register">Need an account? Register</a></p>
			</form>
		</section>
	</div>
{% endblock %}
