<!doctype html>
<html lang="en">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1" />
	<title>{% block title %}Kainos careers{% endblock %}</title>
	<link rel="icon" type="image/png" href="/assets/images/kainos-favicon.png" />
	<link rel="stylesheet" href="/assets/styles/job-role-list.css" />
</head>
<body>
	<header class="hero">
		<div class="hero__content">
			<a class="site-logo" href="/" aria-label="Kainos home">
				<img src="/assets/images/kainos-logo-alt-transparent.png" alt="Kainos" />
			</a>
			<nav class="hero__nav" aria-label="Account">
				{% if isAuthenticated %}
					<a class="hero__nav-link" href="/logout">Sign out</a>
				{% else %}
					<a class="hero__nav-link" href="/login">Sign in</a>
				{% endif %}
			</nav>
			<p class="hero__eyebrow">Kainos Careers</p>
			{% block hero %}{% endblock %}
		</div>
	</header>

	{% block content %}{% endblock %}

	<footer class="site-footer">
		<div class="site-footer__inner">
			<div>
				<strong>Kainos</strong>
				<p>Technology that makes a difference.</p>
			</div>
			<div>
				<h2>Contact</h2>
				<p><a href="mailto:careers@kainos.com">careers@kainos.com</a></p>
				<p><a href="tel:+442890367000">+44 (0)28 9036 7000</a></p>
			</div>
		</div>
	</footer>
</body>
</html>
