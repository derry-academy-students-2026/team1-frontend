# Dependencies
node_modules/

# Build output
dist/
build/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Runtime data
pids/
*.pid
*.pid.lock

# Environment files
.env
.env.*
!.env.example

# TypeScript cache
*.tsbuildinfo

# Test coverage
coverage/
.nyc_output/

# Tooling caches
.cache/
.eslintcache

# OS files
.DS_Store
Thumbs.db

# IDE settings
.vscode/
.idea/

# Code review reports
code_reviews/

# Playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
/playwright/.auth/

# Terraform local files (the .terraform.lock.hcl file is committed on purpose)
.terraform/
*.tfstate
*.tfstate.*
# Saved plans can contain resolved variable values.
tfplan
*.tfplan
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
*.tfvars
*.tfvars.json
# Non-secret per-environment inputs are committed so the pipeline can use them.
!my-infrastructure/environments/*.tfvars
