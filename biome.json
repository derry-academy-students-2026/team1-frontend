{
	"$schema": "https://biomejs.dev/schemas/2.5.7/schema.json",
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"html": {
		"parser": {
			"interpolation": true
		}
	},
	"files": {
		"includes": [
			"**",
			"!coverage",
			"!dist",
			"!build",
			"!code_reviews/context",
			"!playwright-report/index.html",
			"!playwright-report/cucumber-report.html",
			"!test-results"
		]
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended"
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	}
}
