{
	"name": "team1-frontend",
	"version": "1.0.0",
	"type": "module",
	"description": "Team1 Frontend",
	"main": "index.js",
	"scripts": {
		"test": "vitest run --dir tests",
		"test:ui": "vitest --ui --dir tests",
		"test:coverage": "vitest run --dir tests --coverage --coverage.include=src/**/*.ts --coverage.exclude=src/index.ts --coverage.reporter=text --coverage.reporter=html",
		"dev": "tsx watch src/index.ts",
		"build": "tsc",
		"start": "node dist/index.js",
		"lint": "biome check .",
		"lint:fix": "biome check . --write",
		"ci": "echo \"Temporary: no ci specified\""
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/derry-academy-students-2026/team1-frontend.git"
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"bugs": {
		"url": "https://github.com/derry-academy-students-2026/team1-frontend/issues"
	},
	"homepage": "https://github.com/derry-academy-students-2026/team1-frontend#readme",
	"dependencies": {
		"axios": "^1.19.0",
		"dotenv": "^17.4.2",
		"express": "^5.2.1",
		"express-session": "^1.19.0",
		"morgan": "^1.11.0",
		"nunjucks": "^3.2.4",
		"winston": "^3.19.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.7",
		"@types/express": "^5.0.6",
		"@types/express-session": "^1.19.0",
		"@types/morgan": "^1.9.10",
		"@types/node": "^26.1.2",
		"@types/nunjucks": "^3.2.6",
		"@types/supertest": "^7.2.1",
		"@vitest/coverage-v8": "^4.1.10",
		"@vitest/ui": "^4.1.10",
		"supertest": "^7.2.2",
		"tsx": "^4.23.7",
		"typescript": "^7.0.2",
		"vitest": "^4.1.10"
	}
}
